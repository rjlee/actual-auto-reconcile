{
  "name": "actual-auto-reconcile",
  "private": true,
  "version": "1.0.0",
  "description": "Automatically clear and reconcile Actual Budget transactions",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "reconcile": "node src/index.js --mode reconcile",
    "daemon": "node src/index.js --mode daemon",
    "test": "jest --passWithNoTests",
    "test:coverage": "JEST_COVERAGE=true npm test",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix --ext .js .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install || true"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@actual-app/api": "^26.11.0",
    "dotenv": "^18.0.10",
    "js-yaml": "^5.5.0",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "semantic-release": "^26.0.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
